# Discona configuration — copy to .env and edit.
#   cp .env.example .env

# Directory where BSON data files live (default: this directory)
DATA_DIR=.

# Web UI login password — CHANGE THIS
ADMIN_PASSWORD=change-me

# Flask session secret — CHANGE THIS to a long random string
SECRET_KEY=change-me-too

# Optional: shared token required by the machine-readable API endpoints
# (/list_bots, /get_bot, /get_system_config, ...). Leave unset for no token.
# API_TOKEN=
